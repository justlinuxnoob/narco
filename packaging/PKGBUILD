# Maintainer: justlinuxnoob <https://github.com/justlinuxnoob>
#
# Arch / CachyOS / Manjaro package for Narco.
#
#   cd packaging && makepkg -si
#
# Repackages the released portable tarball into a normal system package with a
# desktop entry, an icon, and `narco` on your PATH.

pkgname=narco-bin
_pkgname=narco
# Keep in step with the latest release tag; the source URL is built from it, so
# a mismatch here is a 404 at download time.
pkgver=0.5.5
pkgrel=1
pkgdesc="Private chat for two people. No accounts, no server, no history."
arch=('x86_64')
url="https://github.com/justlinuxnoob/narco"
license=('AGPL-3.0-or-later')
# The tarball is not an AppImage and carries no WebKit of its own.
depends=('webkit2gtk-4.1' 'gtk3')
provides=("$_pkgname")
conflicts=("$_pkgname")
# The bundled tor is an upstream release build; stripping it gains nothing and
# risks breaking a binary we did not compile.
options=('!strip')

source=("$_pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/Narco_${pkgver}_linux_portable.tar.gz")
# 'SKIP' disables verification. For a security tool you should replace it with
# the real hash before installing: run `updpkgsums`, or
# `sha256sum Narco_<ver>_linux_portable.tar.gz`. Left as SKIP so this template
# builds before a release is cut.
sha256sums=('SKIP')

package() {
    cd "$srcdir/Narco_${pkgver}_linux_portable"

    # The app locates its daemon in ./tor beside its own executable, so the two
    # must stay together. /usr/bin/narco is a symlink, and current_exe()
    # resolves it — the lookup lands in /usr/lib/narco/tor either way.
    install -Dm755 narco "$pkgdir/usr/lib/$_pkgname/narco"
    for f in tor/*; do
        install -Dm755 "$f" "$pkgdir/usr/lib/$_pkgname/$f"
    done
    install -dm755 "$pkgdir/usr/bin"
    ln -s "/usr/lib/$_pkgname/narco" "$pkgdir/usr/bin/$_pkgname"

    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/$_pkgname.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Narco
Comment=$pkgdesc
Exec=$_pkgname
Icon=$_pkgname
Categories=Network;InstantMessaging;
Terminal=false
EOF

    for size in 32x32 128x128; do
        icon="$srcdir/../../app/src-tauri/icons/$size.png"
        [ -f "$icon" ] && install -Dm644 "$icon" \
            "$pkgdir/usr/share/icons/hicolor/$size/apps/$_pkgname.png"
    done

    install -Dm644 "$srcdir/../../LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}

# Building from source instead:
#
#   pacman -S --needed rust nodejs npm webkit2gtk-4.1 base-devel curl wget \
#                      file openssl appmenu-gtk-module libappindicator-gtk3 \
#                      librsvg
#   git clone https://github.com/justlinuxnoob/narco && cd narco/app
#   npm ci && npm run tauri build -- --no-bundle
#
# You will also need a tor binary in app/src-tauri/tor/ — see the release
# workflow, which fetches it from the Tor Expert Bundle.
